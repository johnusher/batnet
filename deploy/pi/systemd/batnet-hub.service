[Unit]
Description=batnet hub: the house app, the control panel and the radio link
Wants=meshtasticd.service network-online.target
After=meshtasticd.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
User=batnet
StateDirectory=batnet
ExecStart=/usr/local/bin/batnetd -hub -data /var/lib/batnet -listen :80
# batnetd tells systemd it is alive every 10 s; silent for 30 s means stuck: restart.
WatchdogSec=30
Restart=always
RestartSec=2
# Port 80 and the mesh interface without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
