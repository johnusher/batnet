# The HDMI screen: the hub's control panel full screen in Chromium, inside the
# cage kiosk compositor, on tty1. Not a desktop login: the batnet-screen user
# has no shell and no password. Ctrl+Alt+F2 gives a normal login prompt.
# Only while a screen is plugged in: with none, cage and Chromium drew to
# nothing and kept a CPU core busy. batnetd starts and stops it as screens
# come and go (decision 0029).
[Unit]
Description=batnet screen: the control panel on the HDMI display
Wants=batnet-hub.service
After=batnet-hub.service systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
User=batnet-screen
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# A fresh browser profile in memory on every start: nothing left over (a stale
# profile lock after a hostname change stopped Chromium) and no SD card wear.
RuntimeDirectory=batnet-screen
RuntimeDirectoryMode=0700
# No screen plugged in: don't start (batnetd starts it when one is).
ExecCondition=/bin/sh -c 'grep -qsx connected /sys/class/drm/card*-HDMI-A-*/status'
# Wait (up to a minute) for the panel to answer, so the screen never shows an error page at boot.
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do curl -fs -o /dev/null http://127.0.0.1/hub/ && exit 0; sleep 1; done; exit 0'
# Chromium with the panel, and the screen's sleep and reduced mode (batnet-kiosk).
ExecStart=/usr/bin/cage -s -- /usr/local/lib/batnet/batnet-kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target multi-user.target
